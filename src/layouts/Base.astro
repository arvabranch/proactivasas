---
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppDock from "../components/WhatsAppDock.astro";
import { SITE, SOCIAL } from "../data/site";
import { SERVICIOS } from "../data/servicios";
import ogDefault from "../assets/img/planta-1.jpg";
import logoImg from "../assets/brand/logo-proactiva.png";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** JSON-LD adicional de la página */
  schema?: Record<string, unknown>[];
  waMessage?: string;
  noindex?: boolean;
}
const { title, description, image = ogDefault, schema = [], waMessage, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const ogUrl = new URL(og.src, SITE.url).href;
const logoOut = await getImage({ src: logoImg, width: 600, format: "png" });
const logoUrl = new URL(logoOut.src, SITE.url).href;

const GA_ID = import.meta.env.PUBLIC_GA_ID;
const GSC = import.meta.env.PUBLIC_GSC_VERIFICATION;

const org = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${SITE.url}/#empresa`,
  name: SITE.legalName,
  alternateName: SITE.name,
  slogan: SITE.tagline,
  description: SITE.description,
  url: `${SITE.url}/`,
  telephone: SITE.phoneE164,
  email: SITE.email,
  image: ogUrl,
  logo: logoUrl,
  foundingDate: String(SITE.founded),
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: "CO",
  },
  areaServed: [{ "@type": "City", name: "Cali" }, { "@type": "State", name: "Valle del Cauca" }, { "@type": "Country", name: "Colombia" }],
  knowsAbout: SERVICIOS.map((s) => s.corto),
  ...(SOCIAL.length ? { sameAs: SOCIAL.map((s) => s.url) } : {}),
};
const graph = [org, ...schema];
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#069039" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {GSC && <meta name="google-site-verification" content={GSC} />}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Marca que JS está disponible (solo entonces se ocultan los elementos que aparecen al hacer scroll) -->
    <script is:inline src="/js/boot.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppDock message={waMessage} />

    <script>
      // Revelado progresivo al hacer scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      // Liquid glass: el reflejo especular sigue al puntero
      document.addEventListener(
        "pointermove",
        (e) => {
          const el = (e.target as Element).closest?.<HTMLElement>(".btn--glass");
          if (!el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty("--mx", `${e.clientX - r.left}px`);
          el.style.setProperty("--my", `${e.clientY - r.top}px`);
        },
        { passive: true },
      );
    </script>

    {GA_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline src="/js/analytics.js" data-ga={GA_ID}></script>
      </>
    )}
  </body>
</html>
