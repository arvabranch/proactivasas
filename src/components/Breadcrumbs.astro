---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Ruta de navegación" class="crumbs">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; font-size: 0.9rem; color: var(--label-3); }
  li + li::before { content: "/"; margin-right: 0.4rem; opacity: 0.6; }
  a { color: var(--label-2); text-decoration: none; }
  a:hover { color: var(--label); text-decoration: underline; }
  [aria-current] { color: var(--label); }
</style>
