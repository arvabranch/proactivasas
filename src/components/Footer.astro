---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, SITE, SOCIAL, waLink } from "../data/site";
import { SERVICIOS } from "../data/servicios";
const year = new Date().getFullYear();
---
<footer class="footer dark">
  <div class="container grid">
    <div class="about">
      <Logo height={64} eager={false} class="f-logo" />
      <p>
        Soporte técnico en mantenimiento predictivo para la industria desde {SITE.founded}.
      </p>
      {SOCIAL.length > 0 && (
        <ul class="social" aria-label="Redes sociales">
          {SOCIAL.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-label="Servicios">
      <h2 class="f-title">Servicios</h2>
      <ul>
        {SERVICIOS.map((s) => <li><a href={`/servicios/${s.slug}/`}>{s.corto}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Empresa">
      <h2 class="f-title">Empresa</h2>
      <ul>
        {NAV.filter((n) => n.href !== "/servicios/").map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="f-title">Contacto</h2>
      <ul class="contact">
        <li><a href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a></li>
        <li><a href={`tel:${SITE.phoneE164}`}><Icon name="phone" size={18} /> {SITE.phoneDisplay}</a></li>
        <li><a href={`mailto:${SITE.email}`}><Icon name="mail" size={18} /> {SITE.email}</a></li>
        <li><span><Icon name="pin" size={18} /> {SITE.city}, {SITE.region}, {SITE.country}</span></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>© {year} {SITE.legalName} Todos los derechos reservados.</p>
    <p>Cali, Colombia</p>
  </div>
</footer>

<style>
  .footer { padding: clamp(3.5rem, 7vw, 5rem) 0 calc(5.5rem + env(safe-area-inset-bottom)); }
  .grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr 1fr; }
  .about { grid-column: 1 / -1; max-width: 26rem; }
  .about :global(.f-logo) {
    box-sizing: content-box;
    height: 56px;
    width: auto;
    padding: 0.7rem 1rem;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.6);
  }
  .about p { margin-top: 1.25rem; color: var(--label-2); font-size: 0.97rem; }
  .f-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--label-3);
    margin-bottom: 1rem;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  a, span { color: var(--label-2); text-decoration: none; font-size: 0.97rem; }
  a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 36px; transition: color 200ms; }
  a:hover { color: #fff; }
  .contact span { display: inline-flex; gap: 0.5rem; align-items: center; min-height: 36px; }
  .contact :global(svg) { color: var(--green-400); flex: none; }
  .social { display: flex; gap: 1rem; margin-top: 1.25rem; }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--separator);
    font-size: 0.85rem;
    color: var(--label-3);
  }
  @media (min-width: 860px) {
    .footer { padding-bottom: 2.5rem; }
    .grid { grid-template-columns: 1.5fr 1fr 1fr 1.3fr; }
    .about { grid-column: auto; }
  }
</style>
